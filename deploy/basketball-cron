SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
BOT_DIR=/opt/basketball-bot
VENV=/opt/basketball-bot/venv/bin/python
LOG=/var/log/basketball-bot

# ── Ежедневные задачи ────────────────────────────────────────────────────────

# Daily Bot: игры, опросы, анонсы — каждые 3 часа (быстрее ловим смену
# соперника/переприсвоение game_id лигой, а не раз в сутки)
5 */3 * * * botuser cd $BOT_DIR && $VENV run_game_system.py >> $LOG/game_system.log 2>&1

# SLPRO (Pull Up Farm): опросы/анонсы/результаты — каждые 3 часа
20 */3 * * * botuser cd $BOT_DIR && $VENV run_slpro_monitor.py >> $LOG/slpro.log 2>&1

# Фэнтези: выкачка статистики завершённых игр — каждые 3 часа
35 */3 * * * botuser cd $BOT_DIR && $VENV run_fantasy.py --only ingest >> $LOG/fantasy.log 2>&1

# Фэнтези: понедельничный подсчёт + рассылка таблицы — пн 09:00 МСК (06:00 UTC)
0 6 * * 1 botuser cd $BOT_DIR && $VENV run_fantasy.py --only weekly >> $LOG/fantasy.log 2>&1

# Опросы по тренировкам (создание/актуализация) — 09:05 МСК (06:05 UTC)
5 6 * * * botuser cd $BOT_DIR && $VENV training_polls_enhanced.py >> $LOG/training_polls.log 2>&1

# Мониторинг результатов игр — каждые 30 минут
*/30 * * * * botuser cd $BOT_DIR && $VENV run_game_results_monitor_final.py >> $LOG/game_results.log 2>&1

# День рождения — 09:05 МСК (06:05 UTC)
5 6 * * * botuser cd $BOT_DIR && $VENV run_birthday_notifications.py >> $LOG/birthdays.log 2>&1

# Очистка сервисного листа — 05:00 МСК (02:00 UTC)
0 2 * * * botuser cd $BOT_DIR && $VENV cleanup_service_sheet.py >> $LOG/cleanup.log 2>&1

# Fallback-мониторинг расписания игр — 11:00, 17:00, 23:00 МСК (08:00, 14:00, 20:00 UTC)
0 8,14,20 * * * botuser cd $BOT_DIR && $VENV fallback_game_monitor.py >> $LOG/fallback_monitor.log 2>&1

# ── Еженедельные задачи ──────────────────────────────────────────────────────

# Статистика игрока (Шараев, ID 400566) — воскресенье 10:00 МСК (07:00 UTC)
0 7 * * 0 botuser cd $BOT_DIR && $VENV player_stats.py --person-id 400566 >> $LOG/player_stats.log 2>&1

# Отчёт посещаемости тренировок за неделю — воскресенье 09:00 МСК (06:00 UTC)
0 6 * * 0 botuser cd $BOT_DIR && $VENV training_report.py --week >> $LOG/training_report.log 2>&1

# Отчёт посещаемости игр за неделю — понедельник 09:00 МСК (06:00 UTC)
0 6 * * 1 botuser cd $BOT_DIR && $VENV game_report.py --week >> $LOG/game_report.log 2>&1

# ── Ежемесячные задачи ───────────────────────────────────────────────────────

# Отчёт посещаемости тренировок — 1-е число месяца 09:00 МСК (06:00 UTC)
0 6 1 * * botuser cd $BOT_DIR && $VENV training_report.py >> $LOG/training_report.log 2>&1

# Отчёт посещаемости игр — 1-е число месяца 09:00 МСК (06:00 UTC)
0 6 1 * * botuser cd $BOT_DIR && $VENV game_report.py >> $LOG/game_report.log 2>&1

# Ротация логов cron (оставляем последние 1000 строк; chmod — чтобы
# пересозданный файл не получил широкие права по umask: логи не должны
# быть читаемы посторонними пользователями сервера)
0 3 * * * botuser for f in $LOG/*.log; do tail -1000 "$f" > "$f.tmp" && mv "$f.tmp" "$f" && chmod 640 "$f"; done
