SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
BOT_DIR=/opt/basketball-bot
VENV=/opt/basketball-bot/venv/bin/python
LOG=/var/log/basketball-bot

# ── Ежедневные задачи ────────────────────────────────────────────────────────

# Daily Bot: игры, опросы, анонсы.
# Раз в три часа было слишком редко: анонс на игру мог уйти через два часа
# после старта, а очки фэнтези за вечерний матч появлялись к ночи. Всё это
# идемпотентно (дедуп по service_records), поэтому частый запуск ничего не
# дублирует — он только сокращает задержку. Минуты разведены, чтобы три
# процесса не лезли в чужие API одновременно.
*/15 * * * * botuser cd $BOT_DIR && $VENV run_game_system.py >> $LOG/game_system.log 2>&1

# SLPRO (Pull Up Farm): опросы/анонсы/результаты — каждые 15 минут
5-59/15 * * * * botuser cd $BOT_DIR && $VENV run_slpro_monitor.py >> $LOG/slpro.log 2>&1

# Фэнтези: выкачка статистики завершённых игр — каждые 20 минут
10-59/20 * * * * botuser cd $BOT_DIR && $VENV run_fantasy.py --only ingest >> $LOG/fantasy.log 2>&1

# Фэнтези: понедельничный подсчёт + рассылка таблицы — пн 09:00 МСК (06:00 UTC)
0 6 * * 1 botuser cd $BOT_DIR && $VENV run_fantasy.py --only weekly >> $LOG/fantasy.log 2>&1

# Фэнтези: окно набора состава — каждые 20 мин. Закрывает набор на первом
# анонсе недели, открывает следующий тур после статистики последней игры.
*/20 * * * * botuser cd $BOT_DIR && $VENV run_fantasy.py --only schedule >> $LOG/fantasy.log 2>&1

# Справочники лиг (команды и заявки) в локальную базу. Демон обновляет их сам
# раз в час; cron — страховка на случай, когда демон лежал: он поднимется уже
# с готовыми данными и не полезет в лигу в ответ первому же игроку.
17 */2 * * * botuser cd $BOT_DIR && $VENV run_league_sync.py >> $LOG/league_sync.log 2>&1

# Копия статистики лиг: ночью, порциями по 200 игр с паузой 1.5с между запросами.
# Полный архив (~2100 игр SLPRO + Infobasket) наберётся примерно за две недели,
# при этом чужие серверы не замечают выкачки. Скачанное не перезапрашивается.
# Только от botuser: у остальных трафик уходит в туннель, а обе лиги режут
# иностранные адреса.
30 1 * * * botuser cd $BOT_DIR && $VENV run_backfill.py --source all --scope all --limit 200 >> $LOG/backfill.log 2>&1

# Опросы по тренировкам (создание/актуализация) — 09:05 МСК (06:05 UTC)
5 6 * * * botuser cd $BOT_DIR && $VENV training_polls_enhanced.py >> $LOG/training_polls.log 2>&1

# Мониторинг результатов игр — каждые 30 минут
*/30 * * * * botuser cd $BOT_DIR && $VENV run_game_results_monitor_final.py >> $LOG/game_results.log 2>&1

# День рождения — 09:05 МСК (06:05 UTC)
5 6 * * * botuser cd $BOT_DIR && $VENV run_birthday_notifications.py >> $LOG/birthdays.log 2>&1

# Очистка сервисного листа — 05:00 МСК (02:00 UTC)
0 2 * * * botuser cd $BOT_DIR && $VENV cleanup_service_sheet.py >> $LOG/cleanup.log 2>&1

# Fallback-мониторинг расписания игр — 11:00, 17:00, 23:00 МСК (08:00, 14:00, 20:00 UTC)
0 8,14,20 * * * botuser cd $BOT_DIR && $VENV fallback_game_monitor.py >> $LOG/fallback_monitor.log 2>&1

# ── Еженедельные задачи ──────────────────────────────────────────────────────

# Личная статистика игрока — ОТКЛЮЧЕНО. Слала персональный отчёт в общий чат
# команды (утечка приватного), а данные шли из чужих comp (73582 = «Юноши
# 2010»). Личная статистика по договорённости — только в приват. Вернуть, когда
# будет: (1) верный comp из Конфига, (2) отправка в ЛИЧНЫЙ chat_id (--to <id>).
# 0 7 * * 0 botuser cd $BOT_DIR && $VENV player_stats.py --person-id 400566 --to <ЛИЧНЫЙ_ID> >> $LOG/player_stats.log 2>&1

# Отчёты посещаемости обновляются раз в неделю, пока месяц ещё идёт.
# Лист перезаписывается целиком, но сводки (месяц/квартал/полугодие/год)
# строятся по ВСЕЙ истории голосов из базы — прошлые периоды не теряются.
# Ключ --week ограничивает только детальные секции, иначе лист растёт без предела.

# Тренировки — воскресенье 09:00 МСК (06:00 UTC)
0 6 * * 0 botuser cd $BOT_DIR && $VENV training_report.py --week >> $LOG/training_report.log 2>&1

# Игры — понедельник 09:00 МСК (06:00 UTC)
0 6 * * 1 botuser cd $BOT_DIR && $VENV game_report.py --week >> $LOG/game_report.log 2>&1

# ── Ежемесячные задачи ───────────────────────────────────────────────────────

# Итоги закрытого месяца — 1-е число 09:00 МСК (06:00 UTC). Детали берём за
# ПРОШЛЫЙ месяц: первого числа текущий ещё пуст, и лист остался бы без деталей.
# Своды за квартал/полугодие/год появляются сами, как только период завершился.
0 6 1 * * botuser cd $BOT_DIR && $VENV training_report.py --month $(date -d 'last month' +\%Y-\%m) >> $LOG/training_report.log 2>&1

0 6 1 * * botuser cd $BOT_DIR && $VENV game_report.py --month $(date -d 'last month' +\%Y-\%m) >> $LOG/game_report.log 2>&1

# Личный месячный отчёт (HTML) — 1-го числа 12:00 МСК (09:00 UTC), в ЛИЧКУ
# каждому, кто привязал профиль лиги и не выключил уведомления. Тот же файл
# доступен кнопкой в боте в любой момент. Идемпотентно по last_sent:
# повторный запуск в том же месяце никого не задваивает.
0 9 1 * * botuser cd $BOT_DIR && $VENV monthly_report.py --all >> $LOG/monthly_report.log 2>&1

# Ротация логов cron (оставляем последние 1000 строк; chmod — чтобы
# пересозданный файл не получил широкие права по umask: логи не должны
# быть читаемы посторонними пользователями сервера)
0 3 * * * botuser for f in $LOG/*.log; do tail -1000 "$f" > "$f.tmp" && mv "$f.tmp" "$f" && chmod 640 "$f"; done

# Резервная копия базы — 03:20 МСК (00:20 UTC), в тихий час между ротацией
# логов и утренними задачами. Часть данных (составы фэнтези, зафиксированные
# по играм очки) не восстановима ничем, кроме копии: в листы они не уезжают,
# а из API лиг не выводятся. Держим 7 ежедневных + воскресные за 8 недель,
# локально и на Google Диске.
20 0 * * * botuser cd $BOT_DIR && $VENV backup_db.py >> $LOG/backup.log 2>&1
